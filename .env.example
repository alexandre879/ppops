# Copy to .env and fill in. Used by docker-compose.yml.

# --- Ports on your machine ---
# Public website -> http://localhost:8080, admin platform -> http://localhost:8081
PUBLIC_PORT=8080
ADMIN_PORT=8081
PUBLIC_SITE_URL=http://localhost:8080

# --- Database ---
POSTGRES_DB=newhousemodern
POSTGRES_USER=nhm
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8081
# Local HTTP needs these False. Behind HTTPS in production set both to True,
# and also add SECURE_SSL_REDIRECT=True and SECURE_HSTS_SECONDS=31536000.
AUTH_COOKIE_SECURE=False
SECURE_COOKIES=False

# --- First administrator (created by the seed on first start) ---
ADMIN_EMAIL=admin@newhousemodern.ge
ADMIN_PASSWORD=change-me-admin-password

# --- Website AI assistant ---
# Answers visitors' questions from the website's own content (services, prices, projects,
# contacts). Leave empty to switch it off. Keys: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Questions per visitor IP (each one is a paid API call).
THROTTLE_ASSISTANT=30/hour

# --- Email alerts for new website enquiries ---
# Both EMAIL_URL and ENQUIRY_NOTIFY_EMAILS must be set, otherwise nobody is emailed (the
# enquiry is still saved under Enquiries). Port 587: smtp+tls://, port 465: smtp+ssl://.
# URL-encode "@" in the user name as %40. Gmail needs an app password, not the account one.
#   EMAIL_URL=smtp+tls://office%40example.com:app-password@smtp.gmail.com:587
EMAIL_URL=
# Sender address; defaults to the SMTP user name.
DEFAULT_FROM_EMAIL=
# Comma-separated list of staff addresses that receive each new enquiry.
ENQUIRY_NOTIFY_EMAILS=
# Linked from the alert. With this compose file the admin is on ADMIN_PORT.
ADMIN_URL=http://localhost:8081

# Load company content on start. Add SEED_ARGS=--demo for sample data (never in production).
SEED_ON_START=true
SEED_ARGS=
