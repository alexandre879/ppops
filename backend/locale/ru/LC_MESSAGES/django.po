msgid "A password is required for new users."
msgstr "Для нового пользователя требуется пароль."

msgid "Incorrect email or password."
msgstr "Неверный email или пароль."

msgid "Current password is incorrect."
msgstr "Текущий пароль указан неверно."

msgid "Session expired. Please sign in again."
msgstr "Сеанс истёк. Пожалуйста, войдите снова."

msgid "Not signed in."
msgstr "Вход не выполнен."

msgid "You cannot deactivate your own account."
msgstr "Нельзя деактивировать собственную учётную запись."

msgid "You cannot delete your own account."
msgstr "Нельзя удалить собственную учётную запись."

msgid "Must be greater than zero."
msgstr "Значение должно быть больше нуля."

msgid ""
"This record is linked to other records (for example quotations, contracts or"
" projects) and cannot be deleted. Set it to inactive instead."
msgstr ""
"Эта запись связана с другими записями (например, с предложениями, договорами"
" или проектами) и не может быть удалена. Вместо этого сделайте её "
"неактивной."

