#
msgid ""
msgstr ""
"Language: ka\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "This field is required."
msgstr "ეს ველი სავალდებულოა."

msgid "This field may not be null."
msgstr "ეს ველი არ შეიძლება იყოს ცარიელი."

msgid "This field may not be blank."
msgstr "ეს ველი არ შეიძლება იყოს ცარიელი."

msgid "Ensure this field has no more than {max_length} characters."
msgstr "ველი არ უნდა აღემატებოდეს {max_length} სიმბოლოს."

msgid "Ensure this field has at least {min_length} characters."
msgstr "ველი უნდა შეიცავდეს მინიმუმ {min_length} სიმბოლოს."

msgid "Enter a valid email address."
msgstr "შეიყვანეთ სწორი ელ-ფოსტის მისამართი."

msgid "Enter a valid URL."
msgstr "შეიყვანეთ სწორი URL მისამართი."

msgid "A valid integer is required."
msgstr "საჭიროა მთელი რიცხვი."

msgid "A valid number is required."
msgstr "საჭიროა სწორი რიცხვი."

msgid "Ensure this value is less than or equal to {max_value}."
msgstr "მნიშვნელობა არ უნდა აღემატებოდეს {max_value}-ს."

msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "მნიშვნელობა უნდა იყოს მინიმუმ {min_value}."

msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "რიცხვი არ უნდა შეიცავდეს {max_digits}-ზე მეტ ციფრს."

msgid ""
"Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "ათწილადი ნაწილი არ უნდა აღემატებოდეს {max_decimal_places} ციფრს."

msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr "მთელი ნაწილი არ უნდა აღემატებოდეს {max_whole_digits} ციფრს."

msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr "თარიღის ფორმატი არასწორია. გამოიყენეთ: {format}."

msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "თარიღისა და დროის ფორმატი არასწორია. გამოიყენეთ: {format}."

msgid "\"{input}\" is not a valid choice."
msgstr "„{input}“ დაუშვებელი მნიშვნელობაა."

msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "მოსალოდნელი იყო სია, მიღებულია „{input_type}“."

msgid "This list may not be empty."
msgstr "სია არ შეიძლება იყოს ცარიელი."

msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "ობიექტი „{pk_value}“ ვერ მოიძებნა."

msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "არასწორი ტიპი. მოსალოდნელი იყო იდენტიფიკატორი, მიღებულია {data_type}."

msgid "No file was submitted."
msgstr "ფაილი არ არის გაგზავნილი."

msgid "The submitted file is empty."
msgstr "გაგზავნილი ფაილი ცარიელია."

msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"ატვირთეთ სწორი სურათი. ატვირთული ფაილი სურათი არ არის ან დაზიანებულია."

msgid "Authentication credentials were not provided."
msgstr "ავტორიზაციის მონაცემები არ არის მითითებული."

msgid "Incorrect authentication credentials."
msgstr "ავტორიზაციის მონაცემები არასწორია."

msgid "You do not have permission to perform this action."
msgstr "ამ მოქმედების შესრულების უფლება არ გაქვთ."

msgid "Not found."
msgstr "ვერ მოიძებნა."

msgid "Invalid page."
msgstr "არასწორი გვერდი."

msgid "Method \"{method}\" not allowed."
msgstr "მეთოდი „{method}“ დაუშვებელია."

msgid "Malformed request."
msgstr "არასწორი მოთხოვნა."

msgid "A server error occurred."
msgstr "სერვერის შეცდომა."
